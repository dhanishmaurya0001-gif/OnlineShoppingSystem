@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">

    <h1 class="display-4">
        Welcome To Online Shopping System
    </h1>

    <p class="lead">
        Buy Best Products At Affordable Prices
    </p>

    <br />

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-primary btn-lg">

        Start Shopping

    </a>

</div>

<hr />

<div class="row mt-5">

    <div class="col-md-4">

        <div class="card shadow">

            <div class="card-body text-center">

                <h3>Electronics</h3>

                <p>
                    Latest Mobile, Laptop and Gadgets
                </p>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card shadow">

            <div class="card-body text-center">

                <h3>Fashion</h3>

                <p>
                    Trending Fashion Collection
                </p>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card shadow">

            <div class="card-body text-center">

                <h3>Accessories</h3>

                <p>
                    Premium Quality Accessories
                </p>

            </div>

        </div>

    </div>

</div>