@model OnlineShoppingSystem.Models.Product

<div class="card">

    <img src="@Model.ImageUrl"
         height="300" />

    <div class="card-body">

        <h2>@Model.Name</h2>

        <p>@Model.Description</p>

        <h4>₹@Model.Price</h4>

        <p>
            Category:
            @Model.Category
        </p>

    </div>

</div>