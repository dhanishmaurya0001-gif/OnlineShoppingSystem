@model List<OnlineShoppingSystem.Models.CartItem>
@{ ViewData["Title"] = "Shopping Cart"; }
<h2>Shopping Cart</h2>
@if (Model.Count == 0) { <p>Your cart is empty. <a asp-controller="Products" asp-action="Index">Browse products</a>.</p> }
else {
<table class="table"><thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th>Action</th></tr></thead><tbody>
@foreach (var item in Model) {
<tr><td>@item.ProductName</td><td>₹@item.Price.ToString("N2")</td><td>
<form asp-action="UpdateQuantity" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@item.ProductId" /><input class="form-control" style="max-width:90px" aria-label="Quantity for @item.ProductName" name="quantity" type="number" min="1" max="99" value="@item.Quantity" /><button class="btn btn-outline-primary" type="submit">Update</button></form>
</td><td>₹@((item.Price * item.Quantity).ToString("N2"))</td><td>
<form asp-action="Remove" method="post"><input type="hidden" name="id" value="@item.ProductId" /><button class="btn btn-outline-danger">Remove</button></form>
</td></tr>
}
</tbody></table>
<p class="fw-bold">Cart total: ₹@Model.Sum(x => x.Price * x.Quantity).ToString("N2")</p>
<a asp-action="Checkout" class="btn btn-primary">Preview checkout</a>
}
