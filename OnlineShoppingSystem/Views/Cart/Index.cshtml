@model List<OnlineShoppingSystem.Models.CartItem>

<h2>Shopping Cart</h2>
<a asp-action="Checkout"
   class="btn btn-primary">
    Checkout
</a>

<table class="table">
    <th>Action</th>

    <tr>
        <th>Product</th>
        <th>Price</th>
        <th>Qty</th>
        <th>Total</th>
    </tr>

    @foreach (var item in Model)
    {
        <td>

            <a asp-action="Remove"
               asp-route-id="@item.ProductId"
               class="btn btn-danger">

                Remove

            </a>

        </td>
        <tr>

            <td>@item.ProductName</td>

            <td>₹@item.Price</td>

            <td>@item.Quantity</td>

            <td>
                ₹@(item.Price* item.Quantity)
            </td>

        </tr>
    }

</table>