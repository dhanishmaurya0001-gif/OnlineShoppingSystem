@model IEnumerable<OnlineShoppingSystem.Models.Product>

<h2>Product List</h2>
<th>Action</th>

<a asp-action="Create" class="btn btn-primary mb-3">
    Add Product
</a>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Price</th>
        <th>Image</th>
    </tr>

    @foreach (var item in Model)
    {
        <td>

            <a asp-action="Edit"
               asp-route-id="@item.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@item.Id"
               class="btn btn-danger">
                Delete
            </a>

        </td>
        <tr>
            <td>@item.Name</td>
            <td>@item.Description</td>
            <td>₹@item.Price</td>
            <td>
                <img src="@item.ImageUrl"
                     width="100" />
            </td>
        </tr>
    }
</table>